// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DB_URL")
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  firstName            String?
  lastName             String?
  hashedPassword       String
  passwordResetToken   Token?     @relation(fields: [passwordResetTokenId], references: [id])
  passwordResetTokenId String?
  googleIds            String[]
  company              Company?
  feedback             Feedback[]
  apps                 App[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
}

model Token {
  id        String    @id @default(uuid())
  type      TokenType
  expiresAt DateTime
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  users     User[]
  apps      App[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  address     String
  state       String
  zipCode     String
  country     String
  phoneNumber String
  website     String
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Feedback {
  id        String   @id @default(uuid())
  content   String
  rating    Rating
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model App {
  id            String          @id @default(uuid())
  name          String
  description   String
  url           String
  platform      AppPlatform
  reviewStatus  AppReviewStatus @default(PENDING)
  reviewToken   Token?          @relation(fields: [reviewTokenId], references: [id])
  reviewTokenId String?
  published     Boolean         @default(false)
  user          User            @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
}

enum TokenType {
  PASSWORD_RESET
  REVIEW_APP
}

enum Rating {
  BAD
  NEUTRAL
  GOOD
  GREAT
}

enum AppPlatform {
  WEB
  CROSS_PLATFORM
  IOS
  ANDROID
  MACOS
  WINDOWS
  LINUX
  OTHER
}

enum AppReviewStatus {
  PENDING
  REJECTED
  ACCEPTED
}
